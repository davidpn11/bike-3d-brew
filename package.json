{
  "name": "bike-3d-brew",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config apps/web/vite.config.ts",
    "test:coverage": "vitest run --config apps/web/vite.config.ts --coverage",
    "test:watch": "vitest --config apps/web/vite.config.ts",
    "e2e": "playwright test --config apps/web/playwright.config.ts --project desktop --project mobile",
    "e2e:coverage": "E2E_COVERAGE=1 playwright test --config apps/web/playwright.config.ts --project=desktop --project=mobile",
    "coverage:merge": "node tools/coverage/e2e-coverage.mjs",
    "e2e:webkit": "playwright test --config apps/web/playwright.config.ts --project webkit",
    "e2e:ui": "playwright test --config apps/web/playwright.config.ts --ui",
    "fixtures": "node tools/fixtures/make-capture-bundle.mjs",
    "fixture:capture": "node tools/fixtures/make-capture-bundle.mjs --photos tools/fixtures/out/fixture.bikecapture.zip",
    "fixture:photos": "node tools/fixtures/render-photos.mjs && node tools/fixtures/make-capture-bundle.mjs --photos tools/fixtures/out/fixture-photos.bikecapture.zip --images tools/fixtures/out/photos",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "libheif-js": "^1.23.5",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "^1.0.2",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/istanbul-lib-coverage": "^1.0.2",
    "@vitest/istanbul-lib-report": "^1.0.2",
    "ast-v8-to-istanbul": "^1.0.8",
    "draco3dgltf": "^1.5.9",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "meshoptimizer": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4"
}
