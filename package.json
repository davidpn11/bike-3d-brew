{
  "name": "bike-3d-brew",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config apps/web/vite.config.ts",
    "test:watch": "vitest --config apps/web/vite.config.ts",
    "fixture:capture": "node tools/fixtures/make-capture.mjs",
    "fixture:photos": "node tools/fixtures/render-photos.mjs && node tools/fixtures/make-capture.mjs tools/fixtures/out/fixture-photos.bikecapture.zip --images tools/fixtures/out/photos"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "libheif-js": "^1.23.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
