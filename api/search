11":1},"url":{"1":2,"2":3,"3":3,"4":3,"5":3,"6":3,"7":3,"8":3,"9":3,"10":3,"11":3,"12":3,"13":3,"14":3,"15":3,"16":3,"17":3,"18":3,"19":3,"20":3,"21":2,"22":3,"23":3,"24":2,"25":3,"26":3,"27":3,"28":3,"29":2,"30":3,"31":3,"32":3,"33":3,"34":3,"35":3,"36":3,"37":3,"38":3,"39":3,"40":3,"41":3,"42":3,"43":3,"44":3,"45":3,"46":3,"47":1,"48":1,"49":1,"50":1,"51":1,"52":1,"53":1,"54":2,"55":2,"56":2,"57":2,"58":2,"59":2,"60":2,"61":2,"62":3,"63":3,"64":3,"65":3,"66":3,"67":3,"68":3,"69":3,"70":2,"71":2,"72":3,"73":3,"74":3,"75":3,"76":3,"77":3,"78":3,"79":3,"80":3,"81":3,"82":3,"83":3,"84":3,"85":3,"86":3,"87":3,"88":3,"89":3,"90":3,"91":3,"92":3,"93":3,"94":3,"95":3,"96":3,"97":3,"98":3,"99":3,"100":3,"101":3,"102":3,"103":3,"104":3,"105":3,"106":3,"107":3,"108":3,"109":3,"110":3,"111":2,"112":3,"113":3,"114":3,"115":3,"116":2,"117":3,"118":3,"119":3,"120":3,"121":3,"122":3,"123":3,"124":3,"125":3,"126":3,"127":3,"128":3,"129":3,"130":3,"131":3,"132":3}}},"docs":{"docs":{"1":{"id":"/docs/architecture","page_id":"/docs/architecture","type":"page","content":"Architecture","breadcrumbs":["Docs","Technical"],"tags":[],"url":"/docs/architecture"},"2":{"id":"/docs/architecture-0","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#why-object-capture-instead-of-wes-bos-room-pipeline","content":"Why Object Capture instead of Wes Bos' room pipeline"},"3":{"id":"/docs/architecture-1","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#contracts","content":"Contracts"},"4":{"id":"/docs/architecture-2","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#bike-capture1-ios-export-zip","content":"`bike-capture/1` (iOS export zip)"},"5":{"id":"/docs/architecture-3","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#bike-scene1-viewer-json-bikejson","content":"`bike-scene/1` (viewer JSON, `*.bike.json`)"},"6":{"id":"/docs/architecture-4","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#open-questions-verify-on-device","content":"Open questions (verify on device)"},"7":{"id":"/docs/architecture-5","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#why-object-capture-instead-of-wes-bos-room-pipeline","content":"`wesbos/3d-model-anything` records RoomPlan + LiDAR mesh + posed photos, then an AI agent\nrebuilds the room in three.js. A bike is one object with thin tubes, spokes and cables, so we\nuse Apple's Object Capture: guided orbits, **automatic object masking** (the background is\nremoved during reconstruction; no green screen needed) and a textured USDZ. We keep Wes's\nkey idea of **posed photos**: `poses.json` tells us where each photo was taken, so the viewer\ncan show real close-up photos for an area (e.g. the fork crown) next to the 3D view."},"8":{"id":"/docs/architecture-6","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#why-object-capture-instead-of-wes-bos-room-pipeline","content":"Fallbacks when Object Capture struggles with a bike (thin spokes are the classic failure):\narea mode + a crop box, or a gaussian splat (Scaniverse/Polycam/Luma) for photoreal paint.\nThe green background mode exists for compositing snapshots/videos in other tools."},"9":{"id":"/docs/architecture-7","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-capture1-ios-export-zip","content":"| Path            | Content                                                                                                        |\n| --------------- | -------------------------------------------------------------------------------------------------------------- |\n| `manifest.json` | `{ schema, name, createdAt, device, systemVersion, mode: \"object\"\\|\"area\", model, poses, images, imageCount }` |","table":"table-0"},"10":{"id":"/docs/architecture-8","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-capture1-ios-export-zip","content":"| Path         | Content                       |\n| ------------ | ----------------------------- |\n| `model.usdz` | reconstruction, meters, +Y up |","table":"table-0"},"11":{"id":"/docs/architecture-9","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-capture1-ios-export-zip","content":"| Path         | Content                                                                                              |\n| ------------ | ---------------------------------------------------------------------------------------------------- |\n| `poses.json` | `{ schema: \"bike-poses/1\", samples: [{ sample, file, transform[16] }] }` (column-major camera→model) |","table":"table-0"},"12":{"id":"/docs/architecture-10","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-capture1-ios-export-zip","content":"| Path      | Content                    |\n| --------- | -------------------------- |\n| `images/` | Object Capture HEIC photos |","table":"table-0"},"13":{"id":"/docs/architecture-11","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-capture1-ios-export-zip","content":"| Path          | Content             |\n| ------------- | ------------------- |\n| `record.json` | app-internal record |","table":"table-0"},"14":{"id":"/docs/architecture-12","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-capture1-ios-export-zip","content":"Importing in the browser (`apps/web/src/scene/capture.ts`): dropping a `*.bikecapture.zip`\nunzips it in memory with fflate; nothing is uploaded. The iOS exporter zips its staging folder\n(`NSFileCoordinator .forUploading`), so files usually sit under one top-level directory: the\nshallowest `manifest.json` defines the bundle root and `__MACOSX/` / `._*` entries are ignored.\nOnly `manifest.json`, the model and `poses.json` are decompressed (size-capped); images are just\nlisted. If `manifest.model` is missing, a `glb`/`gltf`/`usdz`/`ply` next to the manifest is used\n(GLB first, e.g. after `tools/usdz-to-glb.py`). A broken `poses.json` is a warning, not an error."},"15":{"id":"/docs/architecture-13","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-capture1-ios-export-zip","content":"The resulting scene gets a stable id (`capture-<name>-<createdAt digits>`) so dropping the same\nbundle again restores its saved areas and comments, and a model URL `bundle:<zip name>/<path>`,\nwhich is never fetched: after a reload the viewer asks for that zip to be dropped again."},"16":{"id":"/docs/architecture-14","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-scene1-viewer-json-bikejson","content":"See `apps/web/src/scene/schema.ts`. A scene references its model by URL (relative to the\nscene file), lists **hotspots** (named camera views: the zoomable areas) and **annotations**\n(surface point + normal, title, body, kind `feature|spec|upgrade|note`, optional price and area).\nAll coordinates are in model-root space."},"17":{"id":"/docs/architecture-15","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#open-questions-verify-on-device","content":"Does `PhotogrammetrySession.Poses` return camera→model transforms in the same frame as the\nUSDZ? (Assumed; validate by projecting a pin into the matching photo.)"},"18":{"id":"/docs/architecture-16","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#open-questions-verify-on-device","content":"Does three.js `USDZLoader` read Object Capture USDZ (binary USDC)? Otherwise convert to GLB."},"19":{"id":"/docs/architecture-17","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#open-questions-verify-on-device","content":"Bike size vs. Object Capture's bounding box limits: area mode is the fallback."},"20":{"id":"/docs/architecture-18","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#open-questions-verify-on-device","content":"_Source: `docs/ARCHITECTURE.md`_"},"21":{"id":"/docs/changelog","page_id":"/docs/changelog","type":"page","content":"Changelog","breadcrumbs":["Docs","Plan"],"tags":[],"url":"/docs/changelog"},"22":{"id":"/docs/changelog-0","page_id":"/docs/changelog","type":"heading","tags":[],"url":"/docs/changelog#unreleased","content":"Unreleased"},"23":{"id":"/docs/changelog-1","page_id":"/docs/changelog","type":"heading","tags":[],"url":"/docs/changelog#added","content":"Added"},"24":{"id":"/docs/changelog-2","page_id":"/docs/changelog","tags":[],"type":"text","url":"/docs/changelog","content":"Every PR adds a line under **Unreleased** (newest first) with its PR number. When the owner\nmerges the stack to `main`, the Unreleased block becomes a dated release."},"25":{"id":"/docs/changelog-3","page_id":"/docs/changelog","tags":[],"type":"text","url":"/docs/changelog#added","content":"Docs & progress site (Fumadocs, `apps/docs`) generated from the repo's markdown: home dashboard with roadmap progress per milestone, latest changes and build commit; \"How to test\" guide; offline search. `tools/publish-pages.sh` publishes it with the viewer (under `/app/`) and a synthetic test bundle to the `gh-pages` branch; `tools/make-test-bundle.mjs` writes a synthetic `*.bikecapture.zip`. The Actions-based `pages.yml` deploy is removed."},"26":{"id":"/docs/changelog-4","page_id":"/docs/changelog","tags":[],"type":"text","url":"/docs/changelog#added","content":"Capture bundle import: drop an iPhone `*.bikecapture.zip` on the viewer; it is unzipped in the browser, the model loads and the scene is named from the manifest. Re-dropping a bundle restores its comments. (#2)"},"27":{"id":"/docs/changelog-5","page_id":"/docs/changelog","tags":[],"type":"text","url":"/docs/changelog#added","content":"Foundation: three.js viewer/editor with areas, pinned sales comments, present mode, background modes, `bike-scene/1` format; iOS Object Capture app skeleton; CI. (#1)"},"28":{"id":"/docs/changelog-6","page_id":"/docs/changelog","tags":[],"type":"text","url":"/docs/changelog#added","content":"_Source: `CHANGELOG.md`_"},"29":{"id":"/docs/goals","page_id":"/docs/goals","type":"page","content":"Goals","breadcrumbs":["Docs","Plan"],"tags":[],"url":"/docs/goals"},"30":{"id":"/docs/goals-0","page_id":"/docs/goals","type":"heading","tags":[],"url":"/docs/goals#product","content":"Product"},"31":{"id":"/docs/goals-1","page_id":"/docs/goals","type":"heading","tags":[],"url":"/docs/goals#success-criteria","content":"Success criteria"},"32":{"id":"/docs/goals-2","page_id":"/docs/goals","type":"heading","tags":[],"url":"/docs/goals#quality-bar-for-every-pr","content":"Quality bar for every PR"},"33":{"id":"/docs/goals-3","page_id":"/docs/goals","type":"heading","tags":[],"url":"/docs/goals#non-goals-for-now","content":"Non-goals (for now)"},"34":{"id":"/docs/goals-4","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#product","content":"A bike shop captures a bike with an iPhone in a few minutes and gets a background-free,\nphotoreal 3D model that sales staff (in store, on a tablet) and customers (on a shared link)\ncan spin, zoom into named areas (fork, drivetrain, cockpit…) and read pinned sales comments."},"35":{"id":"/docs/goals-5","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#success-criteria","content":"**Capture → viewer in under 15 minutes** with no desktop software: capture on iPhone,\nAirDrop the `.bikecapture.zip`, drop it on the viewer."},"36":{"id":"/docs/goals-6","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#success-criteria","content":"**Looks like the real bike**: textures, thin parts (spokes, cables) acceptable; background gone."},"37":{"id":"/docs/goals-7","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#success-criteria","content":"**Fast on phones**: first model visible in < 3 s on iPhone Safari over 4G for a 20 MB model;\n60 fps orbiting with 50 pins."},"38":{"id":"/docs/goals-8","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#success-criteria","content":"**Selling tool, not a 3D toy**: areas and comments are the primary UI; present mode is\nusable by a non-technical salesperson with one hand."},"39":{"id":"/docs/goals-9","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#success-criteria","content":"**Robust**: untrusted files never crash the app; every failure says what to do next."},"40":{"id":"/docs/goals-10","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#quality-bar-for-every-pr","content":"Pure logic in `apps/web/src/scene/` with unit tests; coverage does not go down."},"41":{"id":"/docs/goals-11","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#quality-bar-for-every-pr","content":"`npm run typecheck`, `npm test`, `npm run build` and the E2E suite pass; CI green."},"42":{"id":"/docs/goals-12","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#quality-bar-for-every-pr","content":"UI changes verified in Chromium with screenshots, at desktop and phone sizes."},"43":{"id":"/docs/goals-13","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#quality-bar-for-every-pr","content":"Docs (ROADMAP, CHANGELOG, ARCHITECTURE, guides) updated in the same PR."},"44":{"id":"/docs/goals-14","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#non-goals-for-now","content":"Public release / app store distribution (the owner decides when)."},"45":{"id":"/docs/goals-15","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#non-goals-for-now","content":"Real customer captures in the repo: only generated fixtures."},"46":{"id":"/docs/goals-16","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#non-goals-for-now","content":"_Source: `docs/GOALS.md`_"},"47":{"id":"/docs","page_id":"/docs","type":"page","content":"Overview","breadcrumbs":["Docs"],"tags":[],"url":"/docs"},"48":{"id":"/docs-0","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Capture bikes with an iPhone, show them as background-free 3D models, zoom into components\n(fork, drivetrain, cockpit…) and pin sales comments on them."},"49":{"id":"/docs-1","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"**`apps/ios`**: iPhone capture app (Apple Object Capture: background removed automatically, on-device 3D build, camera poses, shareable bundle)."},"50":{"id":"/docs-2","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"**`apps/web`**: three.js viewer and editor: clear / chroma-green / studio backgrounds, fly-to areas, comment pins, presentation mode, JSON export."},"51":{"id":"/docs-3","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Drop a `.bikecapture.zip` from the iPhone app (or a `.glb`, `.usdz`, `.ply`) onto the viewer to use your own capture. Switch to **Edit** to\ntap the bike and add comments, save camera views as areas; **Present** steps through areas for\na customer."},"52":{"id":"/docs-4","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"See docs/ARCHITECTURE.md, ROADMAP.md and\napps/ios/README.md. Inspired by\nwesbos/3d-model-anything."},"53":{"id":"/docs-5","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"_Source: `README.md`_"},"54":{"id":"/docs/manual-steps","page_id":"/docs/manual-steps","type":"page","content":"Manual steps","breadcrumbs":["Docs","Technical"],"tags":[],"url":"/docs/manual-steps"},"55":{"id":"/docs/manual-steps-0","page_id":"/docs/manual-steps","tags":[],"type":"text","url":"/docs/manual-steps","content":"Things an agent cannot do (hardware, accounts, decisions). Newest first."},"56":{"id":"/docs/manual-steps-1","page_id":"/docs/manual-steps","tags":[],"type":"text","url":"/docs/manual-steps","content":"**Real iPhone capture test** (needs an iPhone with LiDAR, iOS 18+): build `apps/ios`, capture a\nbike, export the `.bikecapture.zip`, drop it on the viewer. Report whether the USDZ loads."},"57":{"id":"/docs/manual-steps-2","page_id":"/docs/manual-steps","tags":[],"type":"text","url":"/docs/manual-steps","content":"**GitHub Pages**: done by the owner on 2026-10-27 (Settings → Pages → Deploy from branch\n`gh-pages`). The site is published from this repo by `tools/publish-pages.sh`."},"58":{"id":"/docs/manual-steps-3","page_id":"/docs/manual-steps","tags":[],"type":"text","url":"/docs/manual-steps","content":"_Source: `docs/MANUAL-STEPS.md`_"},"59":{"id":"/docs/progress","page_id":"/docs/progress","type":"page","content":"Progress","breadcrumbs":["Docs"],"tags":[],"url":"/docs/progress"},"60":{"id":"/docs/progress-0","page_id":"/docs/progress","tags":[],"type":"text","url":"/docs/progress","content":"Roadmap status per milestone, generated from ROADMAP.md at build time."},"61":{"id":"/docs/roadmap","page_id":"/docs/roadmap","type":"page","content":"Roadmap","breadcrumbs":["Docs","Plan"],"tags":[],"url":"/docs/roadmap"},"62":{"id":"/docs/roadmap-0","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#milestone-0-project-ops","content":"Milestone 0: Project ops"},"63":{"id":"/docs/roadmap-1","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#milestone-1-foundation-pr-1","content":"Milestone 1: Foundation (PR 1)"},"64":{"id":"/docs/roadmap-2","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"Milestone 2: Real captures into the viewer"},"65":{"id":"/docs/roadmap-3","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#milestone-3-sales-experience","content":"Milestone 3: Sales experience"},"66":{"id":"/docs/roadmap-4","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#milestone-4-ios-app-depth","content":"Milestone 4: iOS app depth"},"67":{"id":"/docs/roadmap-5","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#milestone-5-backend--multi-bike-catalog","content":"Milestone 5: Backend & multi-bike catalog"},"68":{"id":"/docs/roadmap-6","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#milestone-6-quality","content":"Milestone 6: Quality"},"69":{"id":"/docs/roadmap-7","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#ideas-parking-lot","content":"Ideas parking lot"},"70":{"id":"/docs/roadmap-8","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap","content":"The backlog autonomous sessions work through, top to bottom. Each item is sized for one\nsession / one PR. Protocol is in CLAUDE.md."},"71":{"id":"/docs/roadmap-9","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap","content":"Markers: `[ ]` open · `[~]` in progress (draft PR open) · `[x]` done (in an open or merged PR)."},"72":{"id":"/docs/roadmap-10","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-0-project-ops","content":"[x] **Docs & progress site**: Fumadocs static site (`apps/docs`) generated from the repo's markdown, with a roadmap progress dashboard and a \"How to test\" guide, published with the viewer to GitHub Pages by `tools/publish-pages.sh` (site at `/bike-3d-brew/`, viewer at `/bike-3d-brew/app/`)."},"73":{"id":"/docs/roadmap-11","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-0-project-ops","content":"[ ] **Auto-publish on develop**: a workflow (`contents: write`) that runs `tools/publish-pages.sh --source develop` on every push to `develop`, so the site stays current even when no agent session runs."},"74":{"id":"/docs/roadmap-12","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-0-project-ops","content":"[ ] **PR previews**: publish each open stack PR under `/bike-3d-brew/pr/<n>/` (docs + viewer) and link them from the Progress page, so the owner can test a PR before merging it."},"75":{"id":"/docs/roadmap-13","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-1-foundation-pr-1","content":"Web viewer: three.js, orbit, fly-to areas, background modes (clear / chroma green / studio / dark)"},"76":{"id":"/docs/roadmap-14","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-1-foundation-pr-1","content":"Scene format `bike-scene/1` with validation, local persistence, import/export"},"77":{"id":"/docs/roadmap-15","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-1-foundation-pr-1","content":"Areas (hotspots) and sales comments pinned to the model surface, edit + present modes"},"78":{"id":"/docs/roadmap-16","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-1-foundation-pr-1","content":"Procedural demo bike with seeded areas and comments"},"79":{"id":"/docs/roadmap-17","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-1-foundation-pr-1","content":"iOS app skeleton: Object Capture (object + area mode), on-device reconstruction, poses, bundle export"},"80":{"id":"/docs/roadmap-18","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-1-foundation-pr-1","content":"CI: web typecheck/test/build, unsigned iOS build on macOS, Pages deploy workflow"},"81":{"id":"/docs/roadmap-19","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[x] **Capture bundle import**: drop `*.bikecapture.zip` on the viewer, unzip in the browser (fflate), load `model.usdz`, read `manifest.json` and `poses.json`, name the scene from the manifest. Unit-test the bundle parser with a synthetic zip."},"82":{"id":"/docs/roadmap-20","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **Keep captures across reloads**: cache the unzipped model of the last opened bundles in IndexedDB/OPFS (best effort, quota-aware) so a reload reopens a capture scene without re-dropping the `.bikecapture.zip`."},"83":{"id":"/docs/roadmap-21","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **USDZ robustness**: verify three.js `USDZLoader` against an Object Capture USDZ (binary USDC inside). If unsupported, document and add `tools/usdz-to-glb.py` (Blender headless) plus a clear in-app message. Add a small sample USDZ fixture if licensing allows (generate one, never commit customer captures)."},"84":{"id":"/docs/roadmap-22","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **Auto-orient captures**: detect the ground plane / longest horizontal axis so a scanned bike stands upright facing +X; expose rotate/scale/offset controls in Edit mode (writes `model.rotation/scale/offset`)."},"85":{"id":"/docs/roadmap-23","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **Crop box for area-mode / splat captures**: draggable box in Edit mode that clips everything outside (clipping planes), saved in the scene, so area-mode scans get a clean background."},"86":{"id":"/docs/roadmap-24","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **Photo close-ups per area**: use `poses.json` to find the capture photos that look most directly at each area target (angle + distance score) and show them as a filmstrip under the area; tap to open full screen. HEIC → JPEG conversion at export time on iOS if browsers can't decode HEIC."},"87":{"id":"/docs/roadmap-25","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-3-sales-experience","content":"[ ] **Shareable read-only link**: `?scene=` URL loads a published scene in Present mode with editing hidden; \"Copy share link\" button. Scenes + models served from `apps/web/public/scenes/<id>/`."},"88":{"id":"/docs/roadmap-26","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-3-sales-experience","content":"[ ] **Comment polish**: leader lines from pin to card in Present mode, auto-advance/kiosk mode, comment ordering (drag to reorder), markdown-lite (bold, bullet lists) in bodies."},"89":{"id":"/docs/roadmap-27","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-3-sales-experience","content":"[ ] **Hotspot auto-suggest**: for captures, propose default areas (Fork, Drivetrain, Cockpit, Wheels, Saddle) by letting the user tap each part once; camera view computed from tapped point + local bounds."},"90":{"id":"/docs/roadmap-28","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-3-sales-experience","content":"[ ] **Spec sheet**: per-bike key specs table (frame material, groupset, weight, sizes) shown in Present mode intro and exported."},"91":{"id":"/docs/roadmap-29","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-3-sales-experience","content":"[ ] **Branding**: shop logo, accent color and font in scene settings; applied to Present mode."},"92":{"id":"/docs/roadmap-30","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-3-sales-experience","content":"[ ] **Snapshot / video export**: high-res PNG with transparent or green background; 360° turntable WebM via MediaRecorder for social posts."},"93":{"id":"/docs/roadmap-31","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-3-sales-experience","content":"[ ] **Accessibility & i18n pass**: keyboard navigation for pins, focus states, screen-reader labels, number/currency formatting."},"94":{"id":"/docs/roadmap-32","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-4-ios-app-depth","content":"[ ] **In-app viewer**: RealityKit/SceneKit view of `model.usdz` with the same areas and comments (read `bike-scene/1` JSON), so sales staff can present from the phone offline."},"95":{"id":"/docs/roadmap-33","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-4-ios-app-depth","content":"[ ] **Capture guidance for bikes**: checklist overlay (3 orbits: hub height, saddle height, top-down; close-ups of fork crown, dropouts, rear derailleur, cockpit), shot counter per pass, tips for reflective paint (dulling spray / polarizer), turntable support."},"96":{"id":"/docs/roadmap-34","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-4-ios-app-depth","content":"[ ] **Mac high-detail reconstruction**: `tools/mac-reconstruct` Swift CLI running `PhotogrammetrySession` at `.full` / `.raw` detail from an exported bundle, writing `model.usdz` + `poses.json` back."},"97":{"id":"/docs/roadmap-35","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-4-ios-app-depth","content":"[ ] **On-device GLB export**: convert the USDZ to GLB (ModelIO → glTF writer) so the web viewer never needs conversion."},"98":{"id":"/docs/roadmap-36","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-4-ios-app-depth","content":"[ ] **Upload to viewer**: share sheet target / direct upload of bundles to the web app storage (see Milestone 5)."},"99":{"id":"/docs/roadmap-37","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-5-backend--multi-bike-catalog","content":"[ ] **Catalog page**: list of bikes (cards with turntable thumbnails), search/filter, each opening its scene."},"100":{"id":"/docs/roadmap-38","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-5-backend--multi-bike-catalog","content":"[ ] **Storage**: decide (Cloudflare R2 + Workers, or Supabase) and document; upload bundles, store scenes, auth for editors, public read for shared links."},"101":{"id":"/docs/roadmap-39","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-5-backend--multi-bike-catalog","content":"[ ] **Collaborative comments**: multiple staff editing comments; history."},"102":{"id":"/docs/roadmap-40","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-6-quality","content":"[ ] **Gaussian splat support**: load `.spz` / splat `.ply` (Scaniverse, Polycam, Luma) via Spark (`@sparkjsdev/spark`) for photoreal paint and chrome; crop box + pins work the same."},"103":{"id":"/docs/roadmap-41","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-6-quality","content":"[ ] **Performance**: Draco/Meshopt compression, KTX2 textures, lazy loading, 60 fps on iPhone Safari with 50 pins."},"104":{"id":"/docs/roadmap-42","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-6-quality","content":"[ ] **E2E tests**: Playwright smoke test (load demo, fly to Fork, add comment, export JSON) in CI."},"105":{"id":"/docs/roadmap-43","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-6-quality","content":"[ ] **Docs**: end-to-end guide with screenshots: capture → build → export → annotate → share."},"106":{"id":"/docs/roadmap-44","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#ideas-parking-lot","content":"AR \"place the bike in your room\" via Quick Look (`model.usdz` + `<a rel=\"ar\">`)."},"107":{"id":"/docs/roadmap-45","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#ideas-parking-lot","content":"Compare two bikes side by side."},"108":{"id":"/docs/roadmap-46","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#ideas-parking-lot","content":"Size guide overlay (rider silhouette to scale)."},"109":{"id":"/docs/roadmap-47","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#ideas-parking-lot","content":"Measure tool (tap two points → distance in mm)."},"110":{"id":"/docs/roadmap-48","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#ideas-parking-lot","content":"_Source: `ROADMAP.md`_"},"111":{"id":"/docs/testing-guide","page_id":"/docs/testing-guide","type":"page","content":"How to test","breadcrumbs":["Docs"],"tags":[],"url":"/docs/testing-guide"},"112":{"id":"/docs/testing-guide-0","page_id":"/docs/testing-guide","type":"heading","tags":[],"url":"/docs/testing-guide#on-your-phone-no-setup","content":"On your phone (no setup)"},"113":{"id":"/docs/testing-guide-1","page_id":"/docs/testing-guide","type":"heading","tags":[],"url":"/docs/testing-guide#on-a-laptop","content":"On a laptop"},"114":{"id":"/docs/testing-guide-2","page_id":"/docs/testing-guide","type":"heading","tags":[],"url":"/docs/testing-guide#make-a-synthetic-capture-bundle","content":"Make a synthetic capture bundle"},"115":{"id":"/docs/testing-guide-3","page_id":"/docs/testing-guide","type":"heading","tags":[],"url":"/docs/testing-guide#what-each-pr-adds","content":"What each PR adds"},"116":{"id":"/docs/testing-guide-4","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide","content":"A short guide for the owner: how to try what the agents built, on a phone or a laptop. Every\nPR that adds something testable extends the \"What each PR adds\" table at the bottom."},"117":{"id":"/docs/testing-guide-5","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"Open the live demo: **https://davidpn11.github.io/bike-3d-brew/app/**\n(this site lives one level up: https://davidpn11.github.io/bike-3d-brew/)."},"118":{"id":"/docs/testing-guide-6","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"The procedural demo bike loads with sample areas and comments."},"119":{"id":"/docs/testing-guide-7","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"**View**: drag to orbit, pinch to zoom, tap an area chip (Fork, Drivetrain, Cockpit…) to fly there."},"120":{"id":"/docs/testing-guide-8","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"**Edit**: tap the bike to drop a comment pin; save the current camera as a new area."},"121":{"id":"/docs/testing-guide-9","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"**Present**: steps through the areas one by one, as you would with a customer."},"122":{"id":"/docs/testing-guide-10","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"The background buttons switch between clear, chroma green, studio and dark."},"123":{"id":"/docs/testing-guide-11","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"To try a capture bundle without the iPhone app, download the synthetic one:\n**https://davidpn11.github.io/bike-3d-brew/app/samples/synthetic-bike.bikecapture.zip**,\nthen in the viewer tap **Open…** and pick it from Files. A red low-poly bike replaces the demo\nand the scene is named \"Synthetic test bike\"."},"124":{"id":"/docs/testing-guide-12","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"The site is redeployed by `tools/publish-pages.sh` after each finished PR, so it shows the\nnewest work in the stack, which may not be merged yet. The footer of the home page says which\ncommit and branch it was built from."},"125":{"id":"/docs/testing-guide-13","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-a-laptop","content":"Checks the agents run on every PR (CI runs them too):"},"126":{"id":"/docs/testing-guide-14","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#make-a-synthetic-capture-bundle","content":"The iPhone app exports `*.bikecapture.zip` (format `bike-capture/1`, see\nArchitecture). To test the import path without a phone:"},"127":{"id":"/docs/testing-guide-15","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#make-a-synthetic-capture-bundle","content":"It writes a low-poly bike as `model.glb`, a `manifest.json`, an orbit of camera poses in\n`poses.json` and no photos, all nested in one folder like the real export. Drag the file onto\nthe viewer (or use **Open…**). Dropping the same file again later restores the comments you\nadded to it."},"128":{"id":"/docs/testing-guide-16","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#make-a-synthetic-capture-bundle","content":"With a real capture: AirDrop the `.bikecapture.zip` from the iPhone to the laptop and drop it on\nthe viewer. If the model does not show, note what the viewer says and add it to\nManual steps."},"129":{"id":"/docs/testing-guide-17","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#what-each-pr-adds","content":"| PR            | What to try                                                                           |\n| ------------- | ------------------------------------------------------------------------------------- |\n| #1 Foundation | Demo bike, areas, comments, Edit and Present modes, background switcher, Export JSON. |","table":"table-0"},"130":{"id":"/docs/testing-guide-18","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#what-each-pr-adds","content":"| PR                       | What to try                                                                                                                                                                  |\n| ------------------------ | -------------------------------------------------------------------------------------------------------------------