"94":3,"95":3,"96":2,"97":2,"98":3,"99":3,"100":3,"101":3,"102":3,"103":3,"104":3,"105":3,"106":3,"107":3,"108":3,"109":3,"110":3,"111":3,"112":3,"113":3,"114":3,"115":3,"116":3,"117":3,"118":3,"119":3,"120":3,"121":3,"122":3,"123":3,"124":3,"125":3,"126":3,"127":3,"128":3,"129":3,"130":3,"131":3,"132":3,"133":3,"134":3,"135":3,"136":3,"137":3,"138":3,"139":3,"140":3,"141":3,"142":3,"143":3,"144":3,"145":2,"146":3,"147":3,"148":3,"149":3,"150":2,"151":3,"152":3,"153":3,"154":3,"155":3,"156":3,"157":3,"158":3,"159":3,"160":3,"161":3,"162":3,"163":3,"164":3,"165":3,"166":3}}},"docs":{"docs":{"1":{"id":"/docs/architecture","page_id":"/docs/architecture","type":"page","content":"Architecture","breadcrumbs":["Docs","Technical"],"tags":[],"url":"/docs/architecture"},"2":{"id":"/docs/architecture-0","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#why-object-capture-instead-of-wes-bos-room-pipeline","content":"Why Object Capture instead of Wes Bos' room pipeline"},"3":{"id":"/docs/architecture-1","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#contracts","content":"Contracts"},"4":{"id":"/docs/architecture-2","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#bike-capture1-ios-export-zip","content":"`bike-capture/1` (iOS export zip)"},"5":{"id":"/docs/architecture-3","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#capture-cache-browser-storage","content":"Capture cache (browser storage)"},"6":{"id":"/docs/architecture-4","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#usdz-loading-appswebsrcviewerusd","content":"USDZ loading (`apps/web/src/viewer/usd/`)"},"7":{"id":"/docs/architecture-5","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#bike-scene1-viewer-json-bikejson","content":"`bike-scene/1` (viewer JSON, `*.bike.json`)"},"8":{"id":"/docs/architecture-6","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#photo-close-ups","content":"Photo close-ups"},"9":{"id":"/docs/architecture-7","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#open-questions-verify-on-device","content":"Open questions (verify on device)"},"10":{"id":"/docs/architecture-8","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#why-object-capture-instead-of-wes-bos-room-pipeline","content":"`wesbos/3d-model-anything` records RoomPlan + LiDAR mesh + posed photos, then an AI agent\nrebuilds the room in three.js. A bike is one object with thin tubes, spokes and cables, so we\nuse Apple's Object Capture: guided orbits, **automatic object masking** (the background is\nremoved during reconstruction; no green screen needed) and a textured USDZ. We keep Wes's\nkey idea of **posed photos**: `poses.json` tells us where each photo was taken, so the viewer\ncan show real close-up photos for an area (e.g. the fork crown) next to the 3D view."},"11":{"id":"/docs/architecture-9","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#why-object-capture-instead-of-wes-bos-room-pipeline","content":"Fallbacks when Object Capture struggles with a bike (thin spokes are the classic failure):\narea mode + a crop box, or a gaussian splat (Scaniverse/Polycam/Luma) for photoreal paint.\nThe green background mode exists for compositing snapshots/videos in other tools."},"12":{"id":"/docs/architecture-10","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-capture1-ios-export-zip","content":"| Path            | Content                                                                                                        |\n| --------------- | -------------------------------------------------------------------------------------------------------------- |\n| `manifest.json` | `{ schema, name, createdAt, device, systemVersion, mode: \"object\"\\|\"area\", model, poses, images, imageCount }` |","table":"table-0"},"13":{"id":"/docs/architecture-11","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-capture1-ios-export-zip","content":"| Path         | Content                       |\n| ------------ | ----------------------------- |\n| `model.usdz` | reconstruction, meters, +Y up |","table":"table-0"},"14":{"id":"/docs/architecture-12","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-capture1-ios-export-zip","content":"| Path         | Content                                                                                              |\n| ------------ | ---------------------------------------------------------------------------------------------------- |\n| `poses.json` | `{ schema: \"bike-poses/1\", samples: [{ sample, file, transform[16] }] }` (column-major camera→model) |","table":"table-0"},"15":{"id":"/docs/architecture-13","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-capture1-ios-export-zip","content":"| Path      | Content                    |\n| --------- | -------------------------- |\n| `images/` | Object Capture HEIC photos |","table":"table-0"},"16":{"id":"/docs/architecture-14","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-capture1-ios-export-zip","content":"| Path          | Content             |\n| ------------- | ------------------- |\n| `record.json` | app-internal record |","table":"table-0"},"17":{"id":"/docs/architecture-15","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-capture1-ios-export-zip","content":"Importing in the browser (`apps/web/src/scene/capture.ts`): dropping a `*.bikecapture.zip`\nunzips it in memory with fflate; nothing is uploaded. The iOS exporter zips its staging folder\n(`NSFileCoordinator .forUploading`), so files usually sit under one top-level directory: the\nshallowest `manifest.json` defines the bundle root and `__MACOSX/` / `._*` entries are ignored.\nOnly `manifest.json`, the model and `poses.json` are decompressed (size-capped); images are just\nlisted. If `manifest.model` is missing, a `glb`/`gltf`/`usdz`/`ply` next to the manifest is used\n(GLB first, e.g. after `tools/usdz-to-glb.py`). A broken `poses.json` is a warning, not an error."},"18":{"id":"/docs/architecture-16","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-capture1-ios-export-zip","content":"The resulting scene gets a stable id (`capture-<name>-<createdAt digits>`) so dropping the same\nbundle again restores its saved areas and comments, and a model URL `bundle:<zip name>/<path>`,\nwhich is never fetched: it is resolved from memory or from the capture cache below, and only\nwhen neither has it does the viewer ask for that zip to be dropped again."},"19":{"id":"/docs/architecture-17","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#capture-cache-browser-storage","content":"So a capture scene survives a reload, every successfully opened bundle is kept in the browser\n(`apps/web/src/scene/captureCache.ts`, pure logic; `apps/web/src/storage/backends.ts`, storage):"},"20":{"id":"/docs/architecture-18","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#capture-cache-browser-storage","content":"**What**: the model bytes, `manifest.json`, `poses.json` and the image list. Lazily extracted\nfiles (photos, thumbnails) can be added to an entry later (`putFile`) and are evicted with it.\nThe zip itself is not kept (HEIC photos make it hundreds of MB)."},"21":{"id":"/docs/architecture-19","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#capture-cache-browser-storage","content":"**Where**: OPFS (`navigator.storage.getDirectory()`, folder `bike-captures/`, flat\npercent-encoded file names), falling back to IndexedDB (`bike-3d-brew` / `files`) when OPFS is\nmissing, has no `createWritable()` (older Safari) or refuses a probe write. Neither → no cache,\nthe old \"drop the zip again\" behavior. `navigator.storage.persist()` is requested once per page\nload, on the first store."},"22":{"id":"/docs/architecture-20","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#capture-cache-browser-storage","content":"**Keys**: one entry per `bundle:` model URL; files live under `cap-<slug>-<fnv1a(url)>/…` and an\n`index.json` lists entries (validated on read). An entry remembers the scene id it was opened\nas, so a different bike exported with the same zip filename never loads the wrong model."},"23":{"id":"/docs/architecture-21","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#capture-cache-browser-storage","content":"**Budget**: LRU by last use, `min(500 MB, 50% of the quota − other usage)` from\n`navigator.storage.estimate()`. A bundle larger than the whole budget is simply not cached."},"24":{"id":"/docs/architecture-22","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#capture-cache-browser-storage","content":"**Failure**: every call is best effort. Any storage error leaves the app as if the cache did\nnot exist; entries whose files vanished (browser eviction) are dropped from the index."},"25":{"id":"/docs/architecture-23","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#capture-cache-browser-storage","content":"**UI**: \"Open…\" becomes a small menu once something is stored: \"Choose a file…\" plus the stored\ncaptures (name, size, × to forget)."},"26":{"id":"/docs/architecture-24","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#usdz-loading-appswebsrcviewerusd","content":"Object Capture writes a USDZ whose root layer is **binary USDC (crate)**: one baked triangle\nmesh, indexed face-varying `primvars:st` and normals, a `UsdPreviewSurface` fed by\n`UsdUVTexture` PNGs in `0/` (diffuse, normal with scale 2 / bias -1, occlusion),\n`metersPerUnit = 1`, `upAxis = \"Y\"`."},"27":{"id":"/docs/architecture-25","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#usdz-loading-appswebsrcviewerusd","content":"three.js r186 can read this: `USDLoader` (the old `USDZLoader` is a deprecated alias) has a crate\nparser with LZ4 + integer decoding (`usd/USDCParser.js`) and a composer that handles xforms,\nGeomSubsets, indexed/face-varying primvars, UsdPreviewSurface textures, `metersPerUnit` and Z-up.\nWe reuse those parsers and patch what fails on real-world files:"},"28":{"id":"/docs/architecture-26","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#usdz-loading-appswebsrcviewerusd","content":"`crate.ts` (`CrateParser`): values the crate stores **inline** that r186 misreads: small integral\n`double2/3/4` and `half3/4` (packed int8, e.g. `xformOp:translate = (0, 0, 5)` became a number and\ncrashed the transform), negative `int`, `half`; plus scalar `half3/4`, `quath`, `int4`, `matrix2d/3d`."},"29":{"id":"/docs/architecture-27","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#usdz-loading-appswebsrcviewerusd","content":"`composer.ts` (`FastUSDComposer`): typed-array fast path for all-triangle meshes. Stock three took\n~1.4–2.2 s to build a 1M-triangle mesh (JS arrays per index); this takes ~0.2 s, same output."},"30":{"id":"/docs/architecture-28","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#usdz-loading-appswebsrcviewerusd","content":"`usdz.ts` (`loadUsd`): unzips only USD layers and images, takes the first layer as root (falls back\nto the first USD layer anywhere), composes, waits for textures (blob URLs created and revoked by\nthree per image), halves three's normal-map strength for the standard scale 2 / bias -1 decode,\nand reports undecodable textures as warnings instead of failing."},"31":{"id":"/docs/architecture-29","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#usdz-loading-appswebsrcviewerusd","content":"Measured on a synthetic 23 MB USDZ (972k triangles, 2048² texture; `tools/fixtures/make-usdc.py\n--detail 90 --tex 2048`), Chromium: unzip 16 ms, parse 183 ms, build 206 ms, textures 24 ms. Parsing\nstays on the main thread: a worker would save the ~0.2 s parse but pay ~0.07 s structured-clone of\nthe spec table back, and the build step needs three.js objects on the main thread anyway. The USD\ncode (~70 KB min) is a lazy chunk loaded on the first USDZ. Anything that still fails shows an error\npointing to `tools/usdz-to-glb.py`. Fixtures are synthetic (`apps/web/test/fixtures/README.md`)."},"32":{"id":"/docs/architecture-30","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#bike-scene1-viewer-json-bikejson","content":"See `apps/web/src/scene/schema.ts`. A scene references its model by URL (relative to the\nscene file), lists **hotspots** (named camera views: the zoomable areas) and **annotations**\n(surface point + normal, title, body, kind `feature|spec|upgrade|note`, optional price and area).\nAll coordinates are in model-root space."},"33":{"id":"/docs/architecture-31","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#photo-close-ups","content":"For the active area (its view target, preferring cameras on the side its saved view looks from),\nthe active comment (its pin, preferring cameras in front of its surface normal) and each Present\nstep, the viewer shows a filmstrip of the capture photos that best show that point; tapping one\nopens a full-screen viewer (arrows / swipe, pinch / wheel / double-tap zoom, Esc)."},"34":{"id":"/docs/architecture-32","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#photo-close-ups","content":"**Spaces.** A pose is a column-major camera→reconstruction matrix, camera looking down -Z,\n+Y up. Scene positions are in model-root space. `Viewer.setModel` adds `centerOnGround(object)`\nto the model root, so `modelRoot ⟵ reconstruction` is the loaded object's local matrix (the\ncentering shift plus any root transform the loader applied) times the identity wrapper:\n`src/viewer/captureSpace.ts`. The scene's `model.rotation/scale/offset` sit on the model root\nitself and never enter the mapping. A unit test runs the fixture USDZ through three's\n`USDLoader` + `centerOnGround` and checks the expected close-ups win."},"35":{"id":"/docs/architecture-33","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#photo-close-ups","content":"**Ranking** (`src/scene/photos.ts`, pure): keep photos whose frustum contains the target\n(assumed iPhone wide camera, 65° × 51°, landscape sensor; poses carry no intrinsics), drop\ncameras behind the surface (`side` hint), score `0.45·centered + 0.35·closeness + 0.2·facing`\n(closeness relative to the nearest usable photo, so units do not matter), and skip near-duplicate\nviewpoints. Occlusion is not tested."},"36":{"id":"/docs/architecture-34","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#photo-close-ups","content":"**Photos** (`src/ui/photoLibrary.ts`): extracted one at a time from the dropped zip via its\ncentral directory (`src/scene/zipIndex.ts`: the `File` stays on disk, nothing else is inflated),\ndecoded natively (`createImageBitmap`, then `<img>`; Safari reads HEIC), else HEIC goes to a\nmodule worker that lazily loads libheif (`libheif-js`, WASM, ~2 MB, LGPL-3.0, only fetched when a\nHEIC photo is shown). Results are downscaled to JPEG (360 px thumbnails, 2048 px full) and added\nto the capture cache entry, so after a reload the photos already seen still show without the zip."},"37":{"id":"/docs/architecture-35","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#open-questions-verify-on-device","content":"Does `PhotogrammetrySession.Poses` return camera→model transforms in the same frame as the\nUSDZ? (Assumed, and the photo close-ups depend on it; validate by checking that an area's top\nclose-up really shows that area on a real capture.)"},"38":{"id":"/docs/architecture-36","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#open-questions-verify-on-device","content":"~~Does three.js read Object Capture USDZ (binary USDC)?~~ Yes, with the fixes above, verified on\nsynthetic Object-Capture-like files. Still to confirm on a real capture (docs/MANUAL-STEPS.md)."},"39":{"id":"/docs/architecture-37","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#open-questions-verify-on-device","content":"Bike size vs. Object Capture's bounding box limits: area mode is the fallback."},"40":{"id":"/docs/architecture-38","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#open-questions-verify-on-device","content":"_Source: `docs/ARCHITECTURE.md`_"},"41":{"id":"/docs/changelog","page_id":"/docs/changelog","type":"page","content":"Changelog","breadcrumbs":["Docs","Plan"],"tags":[],"url":"/docs/changelog"},"42":{"id":"/docs/changelog-0","page_id":"/docs/changelog","type":"heading","tags":[],"url":"/docs/changelog#unreleased","content":"Unreleased"},"43":{"id":"/docs/changelog-1","page_id":"/docs/changelog","type":"heading","tags":[],"url":"/docs/changelog#added","content":"Added"},"44":{"id":"/docs/changelog-2","page_id":"/docs/changelog","tags":[],"type":"text","url":"/docs/changelog","content":"Every PR adds a line under **Unreleased** (newest first) with its PR number. When the owner\nmerges the stack to `main`, the Unreleased block becomes a dated release."},"45":{"id":"/docs/changelog-3","page_id":"/docs/changelog","tags":[],"type":"text","url":"/docs/changelog#added","content":"Photo close-ups: for the active area, the active comment and each Present step, a filmstrip of the capture photos that best show it (ranked from `poses.json`), with a full-screen viewer (swipe, arrows, pinch/zoom). Photos are read lazily from the zip, HEIC is decoded natively or by a lazily loaded WASM worker, and thumbnails are kept in the capture cache. (#6)"},"46":{"id":"/docs/changelog-4","page_id":"/docs/changelog","tags":[],"type":"text","url":"/docs/changelog#added","content":"Captures survive reloads: opened `*.bikecapture.zip` bundles are kept in browser storage (OPFS, IndexedDB fallback, LRU under a quota-aware budget) and reopen automatically; \"Open…\" lists stored captures with size and a forget button. Synthetic fixture generator in `tools/fixtures/`. (#5)"},"47":{"id":"/docs/changelog-5","page_id":"/docs/changelog","tags":[],"type":"text","url":"/docs/changelog#added","content":"Docs & progress site (Fumadocs, `apps/docs`) generated from the repo's markdown: home dashboard with roadmap progress per milestone, latest changes and build commit; \"How to test\" guide; offline search. `tools/publish-pages.sh` publishes it with the viewer (under `/app/`) and a synthetic test bundle to the `gh-pages` branch; `tools/make-test-bundle.mjs` writes a synthetic `*.bikecapture.zip`. The Actions-based `pages.yml` deploy is removed. (#4)"},"48":{"id":"/docs/changelog-6","page_id":"/docs/changelog","tags":[],"type":"text","url":"/docs/changelog#added","content":"USDZ robustness: Object Capture USDZ (binary USDC) loads with textures; fixes three.js r186 crate decoding of inline vectors/halves/negative ints, ~10× faster mesh build for large captures, lazy-loaded USD code, clear fallback to `tools/usdz-to-glb.py`. Synthetic fixture generator `tools/fixtures/make-usdc.py`. (#3)"},"49":{"id":"/docs/changelog-7","page_id":"/docs/changelog","tags":[],"type":"text","url":"/docs/changelog#added","content":"Capture bundle import: drop an iPhone `*.bikecapture.zip` on the viewer; it is unzipped in the browser, the model loads and the scene is named from the manifest. Re-dropping a bundle restores its comments. (#2)"},"50":{"id":"/docs/changelog-8","page_id":"/docs/changelog","tags":[],"type":"text","url":"/docs/changelog#added","content":"Foundation: three.js viewer/editor with areas, pinned sales comments, present mode, background modes, `bike-scene/1` format; iOS Object Capture app skeleton; CI. (#1)"},"51":{"id":"/docs/changelog-9","page_id":"/docs/changelog","tags":[],"type":"text","url":"/docs/changelog#added","content":"_Source: `CHANGELOG.md`_"},"52":{"id":"/docs/goals","page_id":"/docs/goals","type":"page","content":"Goals","breadcrumbs":["Docs","Plan"],"tags":[],"url":"/docs/goals"},"53":{"id":"/docs/goals-0","page_id":"/docs/goals","type":"heading","tags":[],"url":"/docs/goals#product","content":"Product"},"54":{"id":"/docs/goals-1","page_id":"/docs/goals","type":"heading","tags":[],"url":"/docs/goals#success-criteria","content":"Success criteria"},"55":{"id":"/docs/goals-2","page_id":"/docs/goals","type":"heading","tags":[],"url":"/docs/goals#quality-bar-for-every-pr","content":"Quality bar for every PR"},"56":{"id":"/docs/goals-3","page_id":"/docs/goals","type":"heading","tags":[],"url":"/docs/goals#non-goals-for-now","content":"Non-goals (for now)"},"57":{"id":"/docs/goals-4","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#product","content":"A bike shop captures a bike with an iPhone in a few minutes and gets a background-free,\nphotoreal 3D model that sales staff (in store, on a tablet) and customers (on a shared link)\ncan spin, zoom into named areas (fork, drivetrain, cockpit…) and read pinned sales comments."},"58":{"id":"/docs/goals-5","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#success-criteria","content":"**Capture → viewer in under 15 minutes** with no desktop software: capture on iPhone,\nAirDrop the `.bikecapture.zip`, drop it on the viewer."},"59":{"id":"/docs/goals-6","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#success-criteria","content":"**Looks like the real bike**: textures, thin parts (spokes, cables) acceptable; background gone."},"60":{"id":"/docs/goals-7","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#success-criteria","content":"**Fast on phones**: first model visible in < 3 s on iPhone Safari over 4G for a 20 MB model;\n60 fps orbiting with 50 pins."},"61":{"id":"/docs/goals-8","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#success-criteria","content":"**Selling tool, not a 3D toy**: areas and comments are the primary UI; present mode is\nusable by a non-technical salesperson with one hand."},"62":{"id":"/docs/goals-9","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#success-criteria","content":"**Robust**: untrusted files never crash the app; every failure says what to do next."},"63":{"id":"/docs/goals-10","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#quality-bar-for-every-pr","content":"Pure logic in `apps/web/src/scene/` with unit tests; coverage does not go down."},"64":{"id":"/docs/goals-11","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#quality-bar-for-every-pr","content":"`npm run typecheck`, `npm test`, `npm run build` and the E2E suite pass; CI green."},"65":{"id":"/docs/goals-12","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#quality-bar-for-every-pr","content":"UI changes verified in Chromium with screenshots, at desktop and phone sizes."},"66":{"id":"/docs/goals-13","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#quality-bar-for-every-pr","content":"Docs (ROADMAP, CHANGELOG, ARCHITECTURE, guides) updated in the same PR."},"67":{"id":"/docs/goals-14","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#non-goals-for-now","content":"Public release / app store distribution (the owner decides when)."},"68":{"id":"/docs/goals-15","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#non-goals-for-now","content":"Real customer captures in the repo: only generated fixtures."},"69":{"id":"/docs/goals-16","page_id":"/docs/goals","tags":[],"type":"text","url":"/docs/goals#non-goals-for-now","content":"_Source: `docs/GOALS.md`_"},"70":{"id":"/docs","page_id":"/docs","type":"page","content":"Overview","breadcrumbs":["Docs"],"tags":[],"url":"/docs"},"71":{"id":"/docs-0","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Capture bikes with an iPhone, show them as background-free 3D models, zoom into components\n(fork, drivetrain, cockpit…) and pin sales comments on them."},"72":{"id":"/docs-1","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"**`apps/ios`**: iPhone capture app (Apple Object Capture: background removed automatically, on-device 3D build, camera poses, shareable bundle)."},"73":{"id":"/docs-2","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"**`apps/web`**: three.js viewer and editor: clear / chroma-green / studio backgrounds, fly-to areas, comment pins, presentation mode, JSON export."},"74":{"id":"/docs-3","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Drop a `.bikecapture.zip` from the iPhone app (or a `.glb`, `.usdz`, `.ply`) onto the viewer to use your own capture. Switch to **Edit** to\ntap the bike and add comments, save camera views as areas; **Present** steps through areas for\na customer."},"75":{"id":"/docs-4","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"See docs/ARCHITECTURE.md, ROADMAP.md and\napps/ios/README.md. Inspired by\nwesbos/3d-model-anything."},"76":{"id":"/docs-5","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"_Source: `README.md`_"},"77":{"id":"/docs/manual-steps","page_id":"/docs/manual-steps","type":"page","content":"Manual steps","breadcrumbs":["Docs","Technical"],"tags":[],"url":"/docs/manual-steps"},"78":{"id":"/docs/manual-steps-0","page_id":"/docs/manual-steps","tags":[],"type":"text","url":"/docs/manual-steps","content":"Things an agent cannot do (hardware, accounts, decisions). Newest first."},"79":{"id":"/docs/manual-steps-1","page_id":"/docs/manual-steps","tags":[],"type":"text","url":"/docs/manual-steps","content":"**Decide on the HEIC decoder license**: photo close-ups decode HEIC in Chrome/Firefox with\n`libheif-js` (LGPL-3.0), shipped as a separate, lazily loaded worker chunk. Fine for a private\ntool; before a public release, either confirm LGPL compliance (unmodified library in its own\nfile, notice in the about/credits) or remove it once the iOS app exports JPEGs (see ROADMAP)."},"80":{"id":"/docs/manual-steps-2","page_id":"/docs/manual-steps","tags":[],"type":"text","url":"/docs/manual-steps","content":"**Close-ups on a real capture**: open a real `.bikecapture.zip` with a few areas and check that\neach area's first photos really show it, in Chrome (WASM HEIC path) and iPhone Safari (native)."},"81":{"id":"/docs/manual-steps-3","page_id":"/docs/manual-steps","tags":[],"type":"text","url":"/docs/manual-steps","content":"**Real Object Capture USDZ in the viewer** (needs a real capture): drop the `model.usdz` (or\nthe `.bikecapture.zip`) on the viewer and compare with Quick Look on the Mac/iPhone: textures\npresent and not flipped, size in meters, bike upright, normal-map bumps not exaggerated. The\nbrowser console logs `USDZ …: N triangles, unzip/parse/build ms`; note those numbers in the\nPR. If anything is off, describe the file structure (`usdcat model.usdz | head -80` without\nsharing the capture) so an agent can re-create it in `tools/fixtures/make-usdc.py`."},"82":{"id":"/docs/manual-steps-4","page_id":"/docs/manual-steps","tags":[],"type":"text","url":"/docs/manual-steps","content":"**Real iPhone capture test** (needs an iPhone with LiDAR, iOS 18+): build `apps/ios`, capture a\nbike, export the `.bikecapture.zip`, drop it on the viewer. Report whether the USDZ loads."},"83":{"id":"/docs/manual-steps-5","page_id":"/docs/manual-steps","tags":[],"type":"text","url":"/docs/manual-steps","content":"**GitHub Pages**: done by the owner on 2026-10-27 (Settings → Pages → Deploy from branch\n`gh-pages`). The site is published from this repo by `tools/publish-pages.sh`."},"84":{"id":"/docs/manual-steps-6","page_id":"/docs/manual-steps","tags":[],"type":"text","url":"/docs/manual-steps","content":"_Source: `docs/MANUAL-STEPS.md`_"},"85":{"id":"/docs/progress","page_id":"/docs/progress","type":"page","content":"Progress","breadcrumbs":["Docs"],"tags":[],"url":"/docs/progress"},"86":{"id":"/docs/progress-0","page_id":"/docs/progress","tags":[],"type":"text","url":"/docs/progress","content":"Roadmap status per milestone, generated from ROADMAP.md at build time."},"87":{"id":"/docs/roadmap","page_id":"/docs/roadmap","type":"page","content":"Roadmap","breadcrumbs":["Docs","Plan"],"tags":[],"url":"/docs/roadmap"},"88":{"id":"/docs/roadmap-0","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#milestone-0-project-ops","content":"Milestone 0: Project ops"},"89":{"id":"/docs/roadmap-1","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#milestone-1-foundation-pr-1","content":"Milestone 1: Foundation (PR 1)"},"90":{"id":"/docs/roadmap-2","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"Milestone 2: Real captures into the viewer"},"91":{"id":"/docs/roadmap-3","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#milestone-3-sales-experience","content":"Milestone 3: Sales experience"},"92":{"id":"/docs/roadmap-4","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#milestone-4-ios-app-depth","content":"Milestone 4: iOS app depth"},"93":{"id":"/docs/roadmap-5","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#milestone-5-backend--multi-bike-catalog","content":"Milestone 5: Backend & multi-bike catalog"},"94":{"id":"/docs/roadmap-6","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#milestone-6-quality","content":"Milestone 6: Quality"},"95":{"id":"/docs/roadmap-7","page_id":"/docs/roadmap","type":"heading","tags":[],"url":"/docs/roadmap#ideas-parking-lot","content":"Ideas parking lot"},"96":{"id":"/docs/roadmap-8","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap","content":"The backlog autonomous sessions work through, top to bottom. Each item is sized for one\nsession / one PR. Protocol is in CLAUDE.md."},"97":{"id":"/docs/roadmap-9","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap","content":"Markers: `[ ]` open · `[~]` in progress (draft PR open) · `[x]` done (in an open or merged PR)."},"98":{"id":"/docs/roadmap-10","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-0-project-ops","content":"[x] **Docs & progress site**: Fumadocs static site (`apps/docs`) generated from the repo's markdown, with a roadmap progress dashboard and a \"How to test\" guide, published with the viewer to GitHub Pages by `tools/publish-pages.sh` (site at `/bike-3d-brew/`, viewer at `/bike-3d-brew/app/`)."},"99":{"id":"/docs/roadmap-11","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-0-project-ops","content":"[ ] **Auto-publish on develop**: a workflow (`contents: write`) that runs `tools/publish-pages.sh --source develop` on every push to `develop`, so the site stays current even when no agent session runs."},"100":{"id":"/docs/roadmap-12","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-0-project-ops","content":"[ ] **PR previews**: publish each open stack PR under `/bike-3d-brew/pr/<n>/` (docs + viewer) and link them from the Progress page, so the owner can test a PR before merging it."},"101":{"id":"/docs/roadmap-13","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-1-foundation-pr-1","content":"Web viewer: three.js, orbit, fly-to areas, background modes (clear / chroma green / studio / dark)"},"102":{"id":"/docs/roadmap-14","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-1-foundation-pr-1","content":"Scene format `bike-scene/1` with validation, local persistence, import/export"},"103":{"id":"/docs/roadmap-15","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-1-foundation-pr-1","content":"Areas (hotspots) and sales comments pinned to the model surface, edit + present modes"},"104":{"id":"/docs/roadmap-16","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-1-foundation-pr-1","content":"Procedural demo bike with seeded areas and comments"},"105":{"id":"/docs/roadmap-17","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-1-foundation-pr-1","content":"iOS app skeleton: Object Capture (object + area mode), on-device reconstruction, poses, bundle export"},"106":{"id":"/docs/roadmap-18","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-1-foundation-pr-1","content":"CI: web typecheck/test/build, unsigned iOS build on macOS, Pages deploy workflow"},"107":{"id":"/docs/roadmap-19","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[x] **Capture bundle import**: drop `*.bikecapture.zip` on the viewer, unzip in the browser (fflate), load `model.usdz`, read `manifest.json` and `poses.json`, name the scene from the manifest. Unit-test the bundle parser with a synthetic zip."},"108":{"id":"/docs/roadmap-20","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[x] **Keep captures across reloads**: cache the unzipped model of the last opened bundles in IndexedDB/OPFS (best effort, quota-aware) so a reload reopens a capture scene without re-dropping the `.bikecapture.zip`."},"109":{"id":"/docs/roadmap-21","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **Capture cache on real Safari / iOS**: verify OPFS `createWritable()` vs. the IndexedDB fallback, quota numbers and `persist()` behavior on iPhone Safari and a home-screen web app; tune the 500 MB budget for phones."},"110":{"id":"/docs/roadmap-22","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **Cache large models without a main-thread copy**: write models to OPFS from a worker (`createSyncAccessHandle`) or straight from the dropped `File` stream, so a 300 MB capture does not briefly double memory on phones."},"111":{"id":"/docs/roadmap-23","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[x] **USDZ robustness**: three r186 reads binary USDC; `apps/web/src/viewer/usd/` fixes its inline-value decoding, speeds up large meshes ~10×, waits for packed textures and falls back to a `tools/usdz-to-glb.py` hint. Synthetic Object-Capture-like fixtures from `tools/fixtures/make-usdc.py`."},"112":{"id":"/docs/roadmap-24","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **Verify a real Object Capture USDZ**: load a real `model.usdz` (owner's iPhone, see docs/MANUAL-STEPS.md), compare against Quick Look; turn anything off into a fixture-based test (synthetic re-creation, never the capture itself)."},"113":{"id":"/docs/roadmap-25","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **Weld USDZ meshes**: three expands face-varying meshes to 3 vertices per triangle (~3M vertices for a 1M-triangle capture); merge identical corners into an indexed geometry to cut GPU memory, and consider decimating for phones."},"114":{"id":"/docs/roadmap-26","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **Auto-orient captures**: detect the ground plane / longest horizontal axis so a scanned bike stands upright facing +X; expose rotate/scale/offset controls in Edit mode (writes `model.rotation/scale/offset`)."},"115":{"id":"/docs/roadmap-27","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **Crop box for area-mode / splat captures**: draggable box in Edit mode that clips everything outside (clipping planes), saved in the scene, so area-mode scans get a clean background."},"116":{"id":"/docs/roadmap-28","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[x] **Photo close-ups per area**: use `poses.json` to find the capture photos that look most directly at each area target (angle + distance score) and show them as a filmstrip under the area; tap to open full screen. HEIC → JPEG conversion at export time on iOS if browsers can't decode HEIC."},"117":{"id":"/docs/roadmap-29","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **iOS JPEG photo export**: write `images/*.jpg` (or a `photos/` folder of 2048 px JPEGs) next to the HEICs in the bundle so Chrome/Firefox skip the 2 MB WASM HEIC decoder and decoding is instant; the web side already prefers whatever decodes natively."},"118":{"id":"/docs/roadmap-30","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **Validate close-ups on a real capture**: confirm Object Capture poses share the USDZ frame and the 65° landscape intrinsics assumption (portrait captures, EXIF rotation); read real intrinsics if the iOS app can export them."},"119":{"id":"/docs/roadmap-31","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **Occlusion-aware close-ups**: raycast from each candidate camera to the target against the loaded mesh and drop photos where the bike hides it."},"120":{"id":"/docs/roadmap-32","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-2-real-captures-into-the-viewer","content":"[ ] **Pin favourite close-ups**: let staff star photos for an area (the schema already has `Hotspot.photos`) and show starred ones first, also in shared links."},"121":{"id":"/docs/roadmap-33","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-3-sales-experience","content":"[ ] **Shareable read-only link**: `?scene=` URL loads a published scene in Present mode with editing hidden; \"Copy share link\" button. Scenes + models served from `apps/web/public/scenes/<id>/`."},"122":{"id":"/docs/roadmap-34","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-3-sales-experience","content":"[ ] **Comment polish**: leader lines from pin to card in Present mode, auto-advance/kiosk mode, comment ordering (drag to reorder), markdown-lite (bold, bullet lists) in bodies."},"123":{"id":"/docs/roadmap-35","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-3-sales-experience","content":"[ ] **Hotspot auto-suggest**: for captures, propose default areas (Fork, Drivetrain, Cockpit, Wheels, Saddle) by letting the user tap each part once; camera view computed from tapped point + local bounds."},"124":{"id":"/docs/roadmap-36","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-3-sales-experience","content":"[ ] **Spec sheet**: per-bike key specs table (frame material, groupset, weight, sizes) shown in Present mode intro and exported."},"125":{"id":"/docs/roadmap-37","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-3-sales-experience","content":"[ ] **Branding**: shop logo, accent color and font in scene settings; applied to Present mode."},"126":{"id":"/docs/roadmap-38","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-3-sales-experience","content":"[ ] **Snapshot / video export**: high-res PNG with transparent or green background; 360° turntable WebM via MediaRecorder for social posts."},"127":{"id":"/docs/roadmap-39","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-3-sales-experience","content":"[ ] **Accessibility & i18n pass**: keyboard navigation for pins, focus states, screen-reader labels, number/currency formatting."},"128":{"id":"/docs/roadmap-40","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-4-ios-app-depth","content":"[ ] **In-app viewer**: RealityKit/SceneKit view of `model.usdz` with the same areas and comments (read `bike-scene/1` JSON), so sales staff can present from the phone offline."},"129":{"id":"/docs/roadmap-41","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-4-ios-app-depth","content":"[ ] **Capture guidance for bikes**: checklist overlay (3 orbits: hub height, saddle height, top-down; close-ups of fork crown, dropouts, rear derailleur, cockpit), shot counter per pass, tips for reflective paint (dulling spray / polarizer), turntable support."},"130":{"id":"/docs/roadmap-42","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-4-ios-app-depth","content":"[ ] **Mac high-detail reconstruction**: `tools/mac-reconstruct` Swift CLI running `PhotogrammetrySession` at `.full` / `.raw` detail from an exported bundle, writing `model.usdz` + `poses.json` back."},"131":{"id":"/docs/roadmap-43","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-4-ios-app-depth","content":"[ ] **On-device GLB export**: convert the USDZ to GLB (ModelIO → glTF writer) so the web viewer never needs conversion."},"132":{"id":"/docs/roadmap-44","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-4-ios-app-depth","content":"[ ] **Upload to viewer**: share sheet target / direct upload of bundles to the web app storage (see Milestone 5)."},"133":{"id":"/docs/roadmap-45","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-5-backend--multi-bike-catalog","content":"[ ] **Catalog page**: list of bikes (cards with turntable thumbnails), search/filter, each opening its scene."},"134":{"id":"/docs/roadmap-46","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-5-backend--multi-bike-catalog","content":"[ ] **Storage**: decide (Cloudflare R2 + Workers, or Supabase) and document; upload bundles, store scenes, auth for editors, public read for shared links."},"135":{"id":"/docs/roadmap-47","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-5-backend--multi-bike-catalog","content":"[ ] **Collaborative comments**: multiple staff editing comments; history."},"136":{"id":"/docs/roadmap-48","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-6-quality","content":"[ ] **Gaussian splat support**: load `.spz` / splat `.ply` (Scaniverse, Polycam, Luma) via Spark (`@sparkjsdev/spark`) for photoreal paint and chrome; crop box + pins work the same."},"137":{"id":"/docs/roadmap-49","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-6-quality","content":"[ ] **Performance**: Draco/Meshopt compression, KTX2 textures, lazy loading, 60 fps on iPhone Safari with 50 pins."},"138":{"id":"/docs/roadmap-50","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-6-quality","content":"[ ] **E2E tests**: Playwright smoke test (load demo, fly to Fork, add comment, export JSON) in CI."},"139":{"id":"/docs/roadmap-51","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#milestone-6-quality","content":"[ ] **Docs**: end-to-end guide with screenshots: capture → build → export → annotate → share."},"140":{"id":"/docs/roadmap-52","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#ideas-parking-lot","content":"AR \"place the bike in your room\" via Quick Look (`model.usdz` + `<a rel=\"ar\">`)."},"141":{"id":"/docs/roadmap-53","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#ideas-parking-lot","content":"Compare two bikes side by side."},"142":{"id":"/docs/roadmap-54","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#ideas-parking-lot","content":"Size guide overlay (rider silhouette to scale)."},"143":{"id":"/docs/roadmap-55","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#ideas-parking-lot","content":"Measure tool (tap two points → distance in mm)."},"144":{"id":"/docs/roadmap-56","page_id":"/docs/roadmap","tags":[],"type":"text","url":"/docs/roadmap#ideas-parking-lot","content":"_Source: `ROADMAP.md`_"},"145":{"id":"/docs/testing-guide","page_id":"/docs/testing-guide","type":"page","content":"How to test","breadcrumbs":["Docs"],"tags":[],"url":"/docs/testing-guide"},"146":{"id":"/docs/testing-guide-0","page_id":"/docs/testing-guide","type":"heading","tags":[],"url":"/docs/testing-guide#on-your-phone-no-setup","content":"On your phone (no setup)"},"147":{"id":"/docs/testing-guide-1","page_id":"/docs/testing-guide","type":"heading","tags":[],"url":"/docs/testing-guide#on-a-laptop","content":"On a laptop"},"148":{"id":"/docs/testing-guide-2","page_id":"/docs/testing-guide","type":"heading","tags":[],"url":"/docs/testing-guide#make-a-synthetic-capture-bundle","content":"Make a synthetic capture bundle"},"149":{"id":"/docs/testing-guide-3","page_id":"/docs/testing-guide","type":"heading","tags":[],"url":"/docs/testing-guide#what-each-pr-adds","content":"What each PR adds"},"150":{"id":"/docs/testing-guide-4","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide","content":"A short guide for the owner: how to try what the agents built, on a phone or a laptop. Every\nPR that adds something testable extends the \"What each PR adds\" table at the bottom."},"151":{"id":"/docs/testing-guide-5","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"Open the live demo: **https://davidpn11.github.io/bike-3d-brew/app/**\n(this site lives one level up: https://davidpn11.github.io/bike-3d-brew/)."},"152":{"id":"/docs/testing-guide-6","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"The procedural demo bike loads with sample areas and comments."},"153":{"id":"/docs/testing-guide-7","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"**View**: drag to orbit, pinch to zoom, tap an area chip (Fork, Drivetrain, Cockpit…) to fly there."},"154":{"id":"/docs/testing-guide-8","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"**Edit**: tap the bike to drop a comment pin; save the current camera as a new area."},"155":{"id":"/docs/testing-guide-9","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"**Present**: steps through the areas one by one, as you would with a customer."},"156":{"id":"/docs/testing-guide-10","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"The background buttons switch between clear, chroma green, studio and dark."},"157":{"id":"/docs/testing-guide-11","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"To try a capture bundle without the iPhone app, download the synthetic one:\n**https://davidpn11.github.io/bike-3d-brew/app/samples/synthetic-bike.bikecapture.zip**,\nthen in the viewer tap **Open…** and pick it from Files. A red low-poly bike replaces the demo\nand the scene is named \"Synthetic test bike\"."},"158":{"id":"/docs/testing-guide-12","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-your-phone-no-setup","content":"The site is redeployed by `tools/publish-pages.sh` after each finished PR, so it shows the\nnewest work in the stack, which may not be merged yet. The footer of the home page says which\ncommit and branch it was built from."},"159":{"id":"/docs/testing-guide-13","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#on-a-laptop","content":"Checks the agents run on every PR (CI runs them too):"},"160":{"id":"/docs/testing-guide-14","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#make-a-synthetic-capture-bundle","content":"The iPhone app exports `*.bikecapture.zip` (format `bike-capture/1`, see\nArchitecture). To test the import path without a phone:"},"161":{"id":"/docs/testing-guide-15","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#make-a-synthetic-capture-bundle","content":"It writes a low-poly bike as `model.glb`, a `manifest.json`, an orbit of camera poses in\n`poses.json` and no photos, all nested in one folder like the real export. Drag the file onto\nthe viewer (or use **Open…**). Dropping the same file again later restores the comments you\nadded to it."},"162":{"id":"/docs/testing-guide-16","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#make-a-synthetic-capture-bundle","content":"With a real capture: AirDrop the `.bikecapture.zip` from the iPhone to the laptop and drop it on\nthe viewer. If the model does not show, note what the viewer says and add it to\nManual steps."},"163":{"id":"/docs/testing-guide-17","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#what-each-pr-adds","content":"| PR            | What to try                                                                           |\n| ------------- | ------------------------------------------------------------------------------------- |\n| #1 Foundation | Demo bike, areas, comments, Edit and Present modes, background switcher, Export JSON. |","table":"table-0"},"164":{"id":"/docs/testing-guide-18","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#what-each-pr-adds","content":"| PR                       | What to try                                                                                                                                                                  |\n| ------------------------ | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| #2 Capture bundle import | **Open…** the synthetic bundle above (or drop it on desktop): it loads and is named from the manifest. Add a comment, reload, open the same file again: the comment is back. |","table":"table-0"},"165":{"id":"/docs/testing-guide-19","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#what-each-pr-adds","content":"| PR        | What to try                                                                     |\n| --------- | ------------------------------------------------------------------------------- |\n| Docs site | This site: the home page shows roadmap progress; **Progress** lists every item. |","table":"table-0"},"166":{"id":"/docs/testing-guide-20","page_id":"/docs/testing-guide","tags":[],"type":"text","url":"/docs/testing-guide#what-each-pr-adds","content":"_Source: `docs/TESTING-GUIDE.md`_"}},"count":166},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":87,"2":164,"3":98,"4":67,"5":92,"6":160,"7":68,"8":132,"9":129,"10":73,"11":104,"12":74,"13":77,"14":76,"15":78,"16":75,"17":110,"18":153,"19":